{
  "_instructions": {
    "about": "Template for job-search/data/search-config.json. Every key the pipeline reads is documented here with neutral placeholder values (healthcare domain, Acme/Beta/DataCo companies). Replace the placeholders with your own career paths, queries, and weights.",
    "how_to_use": "Recommended: run the onboarding skill, which generates a personalized search-config.json from your resume and goals. Manual: copy this file to search-config.json, replace every placeholder value, and set setup_required to false.",
    "setup_required": "Boolean. The shipped search-config.json stub sets this to true and the pipeline refuses to run until it is false (or removed). Set to false once you have personalized the file.",
    "search_locations": "Countries to search. Each query pack's locations field should contain these plus Remote.",
    "query_packs": "Dict keyed by snake_case path key, one pack per career path. Each value needs label (human-readable path name), queries (3+ search strings), locations, and job_type. Onboarding generates 4 to 5 packs; this template shows 3.",
    "role_include_patterns": "Python regexes. A job title must match at least one to pass the title gate. No inline flags like (?i); matching is case-insensitive already.",
    "role_exclude_patterns": "Python regexes. Titles matching any of these are rejected even if an include pattern matched.",
    "employer_exclude_patterns": "Python regexes matched against employer names. Use for industries or org types you never want.",
    "agency_patterns": "Substrings or regexes that identify staffing/recruiting agencies so reposted listings are filtered.",
    "location_exclude_patterns": "Python regexes for locations outside your search_locations. Do not exclude countries you actually want.",
    "role_rescue_keywords": "If a title fails the include gate but its description contains one of these, it gets a second look.",
    "keywords": "Three lists used for description matching: domain (your industry terms), ai (AI/automation terms), tech (tooling terms).",
    "path_check_instructions": "Dict keyed by path number as a string ('1', '2', ...), in the same order as query_packs. Each value is a 3-4 sentence discovery strategy: fit signals, what to look for, disqualifiers, and location requirements.",
    "role_patterns": "Plain-text role titles (not regexes) used by monitoring and prospecting prompts.",
    "scoring": "Keyword-to-weight maps, integers 1-10, higher = stronger signal. Groups: domain_keywords, ai_keywords, role_keywords, comp_indicators, growth_indicators, plus culture_keywords (lists, not weights).",
    "path_aliases": "Maps fuzzy or shortened path names (lowercase) to exact query pack labels so LLM output normalizes correctly. Aim for 3-5 aliases per path.",
    "display_groups": "Groups query pack labels into 3-4 dashboard categories. Each label must exactly match a pack's label field; unmapped paths display under Other.",
    "company_aliases": "Maps name variants (lowercase) to one canonical company name for deduplication."
  },
  "setup_required": false,
  "search_locations": ["United States"],
  "query_packs": {
    "early_stage_ai_healthcare": {
      "label": "Early-Stage AI Healthcare Startups",
      "queries": [
        "implementation manager ai healthcare startup",
        "solutions manager ai clinical platform seed series a",
        "deployment lead ai patient care automation",
        "manager ai healthcare startup"
      ],
      "locations": ["Remote", "United States"],
      "job_type": "fulltime"
    },
    "enterprise_healthcare_sw": {
      "label": "Enterprise Healthcare Software",
      "queries": [
        "solutions manager healthcare software",
        "implementation lead enterprise clinical systems",
        "deployment manager ehr platform",
        "solutions architect healthcare software ai"
      ],
      "locations": ["Remote", "United States"],
      "job_type": "fulltime"
    },
    "ai_platform_companies": {
      "label": "AI Platform Companies",
      "queries": [
        "solutions architect ai platform healthcare vertical",
        "forward deployed engineer ai platform enterprise",
        "applied ai solutions manager healthcare"
      ],
      "locations": ["Remote", "United States"],
      "job_type": "fulltime"
    }
  },
  "role_include_patterns": [
    "deployment (lead|manager|director)",
    "implementation (lead|manager|consultant|director)",
    "solutions (manager|architect|engineer|consultant)",
    "clinical solutions",
    "forward deployed engineer",
    "automation (lead|manager|director)",
    "ai (lead|manager|director)",
    "innovation (lead|manager|director)",
    "digital transformation (lead|director|manager)",
    "senior manager",
    "manager.*(deployment|implementation|solutions|ai|innovation)"
  ],
  "role_exclude_patterns": [
    "intern",
    "medical assistant",
    "staff nurse",
    "billing specialist",
    "account executive",
    "regional sales manager",
    "data entry",
